<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/player_background">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:use_controller="false"
        app:resize_mode="fit" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scaleType="fitCenter"
        android:background="#000000" />

    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="22dp"
        android:paddingTop="18dp"
        android:paddingRight="22dp"
        android:paddingBottom="20dp"
        android:background="@drawable/panel_bg_new">

        <ImageView
            android:id="@+id/brandLogo"
            android:layout_width="270dp"
            android:layout_height="96dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_conecta_transparente"
            android:contentDescription="Conecta Soluções" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Player para Android TV"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/codeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="Código deste dispositivo"
            android:textColor="#C7D8EC"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/codeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="000 000"
            android:textColor="#D9EDFF"
            android:textStyle="bold"
            android:textSize="48sp"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Configure o endereço do servidor."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:gravity="center" />

        <EditText
            android:id="@+id/serverInput"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:hint="IP do computador. Ex.: 192.168.0.48"
            android:singleLine="true"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#8EABC8"
            android:backgroundTint="#3AB8FF"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />

        <LinearLayout
            android:id="@+id/networkPanel"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/network_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:text="◉"
                android:textColor="#55C7FF"
                android:textSize="25sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.35"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rede Wi‑Fi" android:textColor="#8EABC8" android:textSize="10sp" />
                <TextView android:id="@+id/ssidText" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Wi‑Fi conectado" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="32dp" android:layout_marginHorizontal="8dp" android:background="#335B7E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sinal" android:textColor="#8EABC8" android:textSize="10sp" />
                <TextView android:id="@+id/signalText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="32dp" android:layout_marginHorizontal="8dp" android:background="#335B7E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.05"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Qualidade" android:textColor="#8EABC8" android:textSize="10sp" />
                <TextView android:id="@+id/qualityText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Excelente" android:textColor="#29E69D" android:textStyle="bold" android:textSize="13sp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="32dp" android:layout_marginHorizontal="8dp" android:background="#335B7E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IP do dispositivo" android:textColor="#8EABC8" android:textSize="10sp" />
                <TextView android:id="@+id/ipText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/saveServerButton"
            android:layout_width="245dp"
            android:layout_height="46dp"
            android:layout_marginTop="13dp"
            android:text="SALVAR E CONECTAR"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/button_bg" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="200dp"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:text="ALTERAR SERVIDOR"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/button_bg"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/offlineBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="18dp"
        android:padding="10dp"
        android:background="#AA000000"
        android:text="OFFLINE • reproduzindo cache"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
