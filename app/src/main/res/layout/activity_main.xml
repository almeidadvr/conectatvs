<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/player_background">

    <androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" app:use_controller="false" app:resize_mode="fit" />
    <ImageView android:id="@+id/imageView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:scaleType="fitCenter" android:background="#000000" />

    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="430dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingRight="14dp"
        android:paddingBottom="14dp"
        android:background="@drawable/panel_bg_new">

        <ImageView
            android:id="@+id/brandLogo"
            android:layout_width="235dp"
            android:layout_height="66dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="Conecta Soluções" />

        <TextView android:id="@+id/codeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="-6dp" android:text="000 000" android:textColor="#D9EDFF" android:textStyle="bold" android:textSize="38sp" android:letterSpacing="0.08" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Configure o endereço do servidor." android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center" />

        <EditText
            android:id="@+id/serverInput"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:hint="IP do computador. Ex.: 192.168.0.48"
            android:singleLine="true"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#8EABC8"
            android:textSize="12sp"
            android:backgroundTint="#3AB8FF"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

        <LinearLayout
            android:id="@+id/networkPanel"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/network_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_wifi_modern" android:contentDescription="Wi-Fi" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.4" android:orientation="vertical" android:gravity="center_vertical" android:layout_marginLeft="5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rede Wi‑Fi" android:textColor="#8EABC8" android:textSize="8sp" />
                <TextView android:id="@+id/ssidText" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Wi‑Fi conectado" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="10sp" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="26dp" android:layout_marginHorizontal="5dp" android:background="#335B7E" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.8" android:orientation="vertical" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sinal" android:textColor="#8EABC8" android:textSize="8sp" />
                <TextView android:id="@+id/signalText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="10sp" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="26dp" android:layout_marginHorizontal="5dp" android:background="#335B7E" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:orientation="vertical" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Qualidade" android:textColor="#8EABC8" android:textSize="8sp" />
                <TextView android:id="@+id/qualityText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Excelente" android:textColor="#29E69D" android:textStyle="bold" android:textSize="10sp" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="26dp" android:layout_marginHorizontal="5dp" android:background="#335B7E" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:orientation="vertical" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IP do dispositivo" android:textColor="#8EABC8" android:textSize="8sp" />
                <TextView android:id="@+id/ipText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <Button android:id="@+id/saveServerButton" android:layout_width="205dp" android:layout_height="40dp" android:layout_marginTop="9dp" android:text="SALVAR E CONECTAR" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp" android:background="@drawable/button_bg" />
        <Button android:id="@+id/settingsButton" android:layout_width="175dp" android:layout_height="38dp" android:layout_marginTop="6dp" android:text="ALTERAR SERVIDOR" android:textColor="#FFFFFF" android:textSize="10sp" android:background="@drawable/button_bg" android:visibility="gone" />
    </LinearLayout>

    <TextView android:id="@+id/offlineBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="18dp" android:padding="10dp" android:background="#AA000000" android:text="OFFLINE • reproduzindo cache" android:textColor="#FFFFFF" android:textSize="12sp" android:visibility="gone" />
</FrameLayout>
