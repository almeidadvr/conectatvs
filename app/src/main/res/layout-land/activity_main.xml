<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/player_background">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:use_controller="false"
        app:resize_mode="fit" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scaleType="fitCenter"
        android:background="#000000" />

    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="10dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:background="@drawable/panel_bg_new">

        <ImageView
            android:id="@+id/brandLogo"
            android:layout_width="190dp"
            android:layout_height="76dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="Conecta Soluções" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Player para Android TV"
            android:textColor="#D5E7F8"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Código deste dispositivo"
            android:textColor="#AFC7DF"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/codeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="000 000"
            android:textColor="#E6F4FF"
            android:textStyle="bold"
            android:textSize="30sp"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Configure o endereço do servidor."
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:gravity="center"
            android:maxLines="2" />

        <EditText
            android:id="@+id/serverInput"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:hint="IP do computador. Ex.: 192.168.0.48"
            android:singleLine="true"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#7898B8"
            android:textSize="10sp"
            android:backgroundTint="#3AB8FF"
            android:paddingLeft="7dp"
            android:paddingRight="7dp" />

        <LinearLayout
            android:id="@+id/networkPanel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/network_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_wifi_modern"
                android:contentDescription="Wi-Fi" />

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.45" android:orientation="vertical" android:gravity="center_vertical" android:layout_marginLeft="5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rede Wi‑Fi" android:textColor="#7999B8" android:textSize="7sp" />
                <TextView android:id="@+id/ssidText" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="—" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="28dp" android:layout_marginHorizontal="5dp" android:background="#28567A" />

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.75" android:orientation="vertical" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sinal" android:textColor="#7999B8" android:textSize="7sp" />
                <TextView android:id="@+id/signalText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="28dp" android:layout_marginHorizontal="5dp" android:background="#28567A" />

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.95" android:orientation="vertical" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Qualidade" android:textColor="#7999B8" android:textSize="7sp" />
                <TextView android:id="@+id/qualityText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#29E69D" android:textStyle="bold" android:textSize="9sp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="28dp" android:layout_marginHorizontal="5dp" android:background="#28567A" />

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.05" android:orientation="vertical" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IP" android:textColor="#7999B8" android:textSize="7sp" />
                <TextView android:id="@+id/ipText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/saveServerButton"
            android:layout_width="170dp"
            android:layout_height="34dp"
            android:layout_marginTop="7dp"
            android:text="SALVAR E CONECTAR"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="9sp"
            android:background="@drawable/button_bg" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="150dp"
            android:layout_height="32dp"
            android:layout_marginTop="5dp"
            android:text="ALTERAR SERVIDOR"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:background="@drawable/button_bg"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/offlineBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:padding="7dp"
        android:background="#AA000000"
        android:text="OFFLINE • reproduzindo cache"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:visibility="gone" />
</FrameLayout>
